SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=4000
NODE_ENV=production
# Comma-separated list of frontend origins allowed to call this API from a browser.
ALLOWED_ORIGINS=https://your-frontend-domain.com
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# PayMongo (QRPh invoices) — https://dashboard.paymongo.com/developers/api-keys
# Use sk_test_... while developing; switch to sk_live_... to go live.
PAYMONGO_SECRET_KEY=sk_test_your-secret-key
# From Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (register the endpoint at https://your-domain/api/payments/webhook/paymongo)
PAYMONGO_WEBHOOK_SECRET=whsk_your-webhook-signing-secret

# PhilSMS (https://philsms.com) — telecom-integrated SMS gateway for the
# Philippines. Get the token from your account's Dashboard > Developers page,
# note the API host is account-specific (e.g. dashboard.philsms.com), copy it
# exactly as shown there rather than assuming app.philsms.com from the public
# docs, that domain 401s. PHILSMS_SENDER_ID is the Sender Name/ID registered
# on your account (max 11 chars), "PhilSMS" is the default trial sender.
PHILSMS_API_TOKEN=your-philsms-api-token
PHILSMS_SENDER_ID=PhilSMS

# SMS Mobile API (https://smsmobileapi.com) — the SMS provider PhilSMS above
# replaced, left here unused in case of rollback.
SMSMOBILEAPI_KEY=your-smsmobileapi-key

# Vertex AI (Gemini) — GAS scorecard AI summaries. Needs the Vertex AI API
# enabled + billing on the GCP project, and Application Default Credentials
# available to this process (run `gcloud auth application-default login`
# locally, or a service account key in production).
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
